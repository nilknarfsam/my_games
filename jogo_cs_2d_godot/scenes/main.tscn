[node name="HpLabel" type="Label" parent="HudUI/TopBar/HBox"]
layout_mode = 2
text = "HP: 100"

[node name="AmmoLabel" type="Label" parent="HudUI/TopBar/HBox"]
layout_mode = 2
text = "Munição: 15/15"

[node name="RoundLabel" type="Label" parent="HudUI/TopBar/HBox"]
layout_mode = 2
