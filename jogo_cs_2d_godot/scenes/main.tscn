text = "Round 1"
horizontal_alignment = 1

[node name="RestartBtn" type="Button" parent="HudUI/TopBar/HBox"]
layout_mode = 2
text = "Reiniciar Round"

[node name="LeaveBtn" type="Button" parent="HudUI/TopBar/HBox"]
layout_mode = 2
text = "Sair"

[node name="ControlsHint" type="Label" parent="HudUI"]
anchors_preset = 12
